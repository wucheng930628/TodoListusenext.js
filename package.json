{
  "name": "mytodolist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:server": "node --conditions=react-server --test tests/phase2.test.mjs",
    "test:db": "node --conditions=react-server scripts/phase2-integration.mjs",
    "db:index:plan": "node --conditions=react-server scripts/phase2-index.mjs",
    "dev:api": "node scripts/dev-local-api.mjs",
    "test:api": "node --conditions=react-server --test tests/api.test.mjs",
    "test:api:http": "node --conditions=react-server scripts/phase3-http-test.mjs",
    "test:phase4a": "node --conditions=react-server --test tests/client-adapter.test.mjs tests/workspace-backup.test.mjs tests/migration-preparation.test.mjs tests/adapter-api.integration.test.mjs",
    "test:migration": "node --conditions=react-server --test tests/migration-service.test.mjs tests/migration-api.test.mjs",
    "test:react-api": "node --test tests/react-api-hooks.test.mjs tests/resource-controller.test.mjs",
    "test:db:migration": "node --conditions=react-server scripts/phase4b1-dynamodb-test.mjs",
    "test:controlled-ui": "node --import ./tests/helpers/server-only-loader.mjs --test tests/controlled-ui.test.mjs tests/controlled-view.test.mjs",
    "test:db:controlled-ui": "node --import ./tests/helpers/server-only-loader.mjs scripts/phase4b2-integration.mjs",
    "test:release": "node --conditions=react-server --test tests/release.test.mjs",
    "test:cutover-react": "node --import ./tests/helpers/server-only-loader.mjs --test tests/cutover-react.test.mjs",
    "test:db:release": "node --import ./tests/helpers/server-only-loader.mjs scripts/phase4c1-integration.mjs",
    "test:main-ui": "node --import ./tests/helpers/server-only-loader.mjs --test tests/main-ui.test.mjs",
    "test:main-ui:react": "node --import ./tests/helpers/ui-module-loader.mjs --test tests/main-ui-react.test.mjs",
    "test:db:main-ui": "node --import ./tests/helpers/ui-module-loader.mjs scripts/phase4c2-integration.mjs",
    "test:safe-create": "node --import ./tests/helpers/server-only-loader.mjs --test tests/safe-create.test.mjs",
    "migration:dry-run": "node --conditions=react-server scripts/migration-dry-run.mjs",
    "test:dry-run": "node --import ./tests/helpers/server-only-loader.mjs --test tests/dry-run.test.mjs",
    "test:backup:react": "node --import ./tests/helpers/ui-module-loader.mjs --test tests/backup-tool-react.test.mjs",
    "test:db:dry-run": "node --test tests/dry-run-db.test.mjs",
    "test:source-exclusion": "node --conditions=react-server --test tests/source-exclusion.test.mjs",
    "test:cutover-safety": "node --import ./tests/helpers/server-only-loader.mjs --test tests/cutover-safety.test.mjs",
    "test:cutover-safety:react": "node --import ./tests/helpers/ui-module-loader.mjs --test tests/cutover-safety-react.test.mjs",
    "test:trusted-evidence": "node --import ./tests/helpers/server-only-loader.mjs --test tests/trusted-evidence.test.mjs",
    "test:db:trusted-evidence": "node --import ./tests/helpers/server-only-loader.mjs scripts/phase4d2c-evidence-integration.mjs --isolated-table"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1168.0",
    "@aws-sdk/lib-dynamodb": "^3.1168.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3"
  }
}
